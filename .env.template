# Set this to "false" if you are using managed Cloud databases instead of local Docker compose containers
RUN_LOCAL_DOCKER=true

# CognoDB Cloud (Managed SaaS)
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password

# ArangoDB (Local Docker or ArangoGraph Cloud)
ARANGODB_URI=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=rootpassword

# FalkorDB (Local Docker or FalkorDB Cloud / Redis Enterprise)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your_falkordb_cloud_password_if_using_saas

# Memgraph (Local Docker or Memgraph Cloud)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Neo4j (Local Docker or Neo4j Aura Cloud)
NEO4J_URI=bolt://localhost:7473
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
